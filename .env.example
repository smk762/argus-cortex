# Optional stateful services layer (argus_cortex.store).
# Every value is optional: unset a URL and that feature no-ops (graceful degrade).
# Copy to .env and fill in only the services you actually run.

# Postgres — lineage DAG + human-edit capture (Phase 1).
# Unset -> open_lineage_store() returns a no-op NullLineageStore.
CORTEX_PG_URL=postgresql://user:pass@localhost:5432/argus
# Connection-pool bounds (optional; defaults 1 / 8).
CORTEX_PG_POOL_MIN_SIZE=1
CORTEX_PG_POOL_MAX_SIZE=8

# Qdrant — image + tag-set embeddings (Phase 2).
CORTEX_QDRANT_URL=http://localhost:6333

# MinIO / S3 — owned image bytes (Phase 3). Scheme-less endpoint defaults to TLS;
# write http:// explicitly for a plaintext endpoint. Region matters on AWS S3.
CORTEX_S3_ENDPOINT=http://localhost:9000
CORTEX_S3_ACCESS_KEY=
CORTEX_S3_SECRET_KEY=
CORTEX_S3_BUCKET=argus
CORTEX_S3_REGION=us-east-1
